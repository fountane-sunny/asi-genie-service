# Copy to .env and fill in values. The Go process does not load .env automatically — use `make run` or `set -a; source .env; set +a`.

# ---- LLM ----
# openai | anthropic | gemini | none (keyword routing only)
LLM_PROVIDER=none
LLM_MODEL=
LLM_FALLBACK_MODEL=
LLM_ATTEMPT_TIMEOUT=12s
LLM_TIMEOUT=30s
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
# Follow-up chips after each reply. true spends an extra model call; anything else leaves them off.
GENIE_SUGGESTIONS=false

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=

# ---- Orchestrator ----
PORT=8090
APP_ENV=local
GENIE_CORS_ORIGIN=http://localhost:3000

# ---- ASI services (all required) ----
ASI_CONFIG_BASE_URL=http://localhost:8080/v1
ASI_AUTH_BASE_URL=http://localhost:8081/v1/auth
ASI_REPORTING_BASE_URL=http://localhost:8082/v1/reporting
ASI_RESERVATION_BASE_URL=http://localhost:8083/api/v1

# ---- Postgres (docker-compose; host port 5434 by default) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_HOST_PORT=5434
POSTGRES_USER=asi_genie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=asi_genie
POSTGRES_SSLMODE=disable
DATABASE_URL=postgres://asi_genie:change-me@localhost:5434/asi_genie?sslmode=disable

# ---- Logging ----
LOG_LEVEL=
LOG_BODIES=
LOG_BODY_MAX=4000
LOG_COLOR=
